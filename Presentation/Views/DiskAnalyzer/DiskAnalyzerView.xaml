<UserControl x:Class="ResetExplode.DiskAnalyzer.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:disk="clr-namespace:ResetExplode.DiskAnalyzer"
             xmlns:app="clr-namespace:GeolabTITools.Application.Features.Disks.DTOs;assembly=GeolabTITools.Application"
             FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
             Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}">
    <UserControl.Resources>
        <Style x:Key="DiskUsageBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{DynamicResource Line}"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30">
            <Grid Margin="0,0,0,20">
                <StackPanel Margin="0,0,190,0">
                    <TextBlock Text="Analisador de Disco" Style="{StaticResource H1}"/>
                    <TextBlock Text="Unidades e utilização do espaço" Style="{StaticResource Sub}"/>
                </StackPanel>
                <Button Content="ATUALIZAR UNIDADES" Command="{Binding RefreshDrivesCommand}"
                        Style="{StaticResource OutlineButton}" Padding="16,9" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <TextBlock Text="UNIDADES DISPONÍVEIS PARA LEITURA" Style="{StaticResource Label}"/>
            <ItemsControl ItemsSource="{Binding Drives}" Margin="0,0,0,14">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="18" CornerRadius="14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Card}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Selection}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding RootPath}" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="  ·  " Foreground="{DynamicResource Faint}" FontSize="16"/>
                                        <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DriveKind}" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Sistema de arquivos: " Foreground="{DynamicResource Faint}" FontSize="11"/>
                                        <TextBlock Text="{Binding FileSystem}" Foreground="{DynamicResource Faint}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,18,0">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,7">
                                        <TextBlock Text="{Binding CapacityText}" Foreground="{DynamicResource Muted}"/>
                                        <TextBlock Text="{Binding UsagePercentText}" FontWeight="SemiBold" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource DiskUsageBar}" Value="{Binding UsagePercent, Mode=OneWay}"/>
                                    <DockPanel LastChildFill="False" Margin="0,7,0,0">
                                        <TextBlock Text="{Binding UsedText}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                        <TextBlock Text="{Binding FreeText}" Foreground="{DynamicResource Muted}" FontSize="11" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Content="SELECIONAR" Padding="16,9" MinWidth="128"
                                        Command="{Binding DataContext.SelectDriveCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}" VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Content" Value="SELECIONADA"/>
                                                    <Setter Property="Background" Value="{DynamicResource Hover}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                <Button Content="INICIAR ANÁLISE" Command="{Binding StartAnalysisCommand}"
                        Style="{StaticResource PrimaryButton}" Padding="18,8" Margin="0,0,8,0"/>
                <Button Content="PAUSAR" Command="{Binding PauseAnalysisCommand}"
                        Style="{StaticResource OutlineButton}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="RETOMAR" Command="{Binding ResumeAnalysisCommand}"
                        Style="{StaticResource OutlineButton}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="CANCELAR" Command="{Binding CancelAnalysisCommand}"
                        Style="{StaticResource OutlineButton}" Padding="14,8"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18" Padding="18">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,9">
                        <TextBlock Text="PROGRESSO DA ANÁLISE" Style="{StaticResource Label}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="Tempo: " Foreground="{DynamicResource Muted}"/>
                            <TextBlock Text="{Binding ElapsedText}" Foreground="{DynamicResource Muted}"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar Style="{StaticResource DiskUsageBar}" Height="14" IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Value="{Binding ProgressValue, Mode=OneWay}" Margin="0,0,0,12"/>
                    <DockPanel LastChildFill="False" Margin="0,0,0,5">
                        <TextBlock Text="Unidade" Foreground="{DynamicResource Muted}"/>
                        <TextBlock Text="{Binding SelectedDrive.RootPath}" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <TextBlock Text="Pasta atual" Foreground="{DynamicResource Muted}" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentDirectory}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="INDICADORES" Style="{StaticResource Label}"/>
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="ESPAÇO ANALISADO" Style="{StaticResource Label}"/><TextBlock Text="{Binding BytesScannedText}" Style="{StaticResource Big}"/><TextBlock Text="lido até agora" Foreground="{DynamicResource Faint}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="4,0">
                    <StackPanel><TextBlock Text="ARQUIVOS" Style="{StaticResource Label}"/><TextBlock Text="{Binding FilesScannedText}" Style="{StaticResource Big}"/><TextBlock Text="encontrados" Foreground="{DynamicResource Faint}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <StackPanel><TextBlock Text="PASTAS" Style="{StaticResource Label}"/><TextBlock Text="{Binding FoldersScannedText}" Style="{StaticResource Big}"/><TextBlock Text="processadas" Foreground="{DynamicResource Faint}"/></StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ARQUIVOS ENCONTRADOS" Style="{StaticResource Label}" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding VisibleFilesCountText}" Foreground="{DynamicResource Muted}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="ABRIR LOCALIZAÇÃO" Command="{Binding OpenFileLocationCommand}" Style="{StaticResource OutlineButton}" Padding="12,7" Margin="0,0,6,0"/>
                            <Button Content="ABRIR PASTA" Command="{Binding OpenFileFolderCommand}" Style="{StaticResource OutlineButton}" Padding="12,7" Margin="0,0,6,0"/>
                            <Button Content="COPIAR CAMINHO" Command="{Binding CopyFilePathCommand}" Style="{StaticResource OutlineButton}" Padding="12,7"/>
                        </StackPanel>
                    </Grid>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Pesquisar pelo nome do arquivo…"
                             Height="38" Margin="0,0,0,10"/>
                    <TextBlock Text="FILTRAR POR EXTENSÃO" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <ScrollViewer MaxHeight="78" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding ExtensionFilters}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 GroupName="DiskFileExtensionFilter" Style="{StaticResource Chip}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="ORDENAR POR" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding SortOptions}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             GroupName="DiskFileSort" Style="{StaticResource Chip}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DataGrid ItemsSource="{Binding VisibleFiles}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True" Height="430" MinRowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NOME" Binding="{Binding Name}" Width="1.1*"/>
                            <DataGridTextColumn Header="EXTENSÃO" Binding="{Binding Extension}" Width="90"/>
                            <DataGridTextColumn Header="CAMINHO COMPLETO" Binding="{Binding FullPath}" Width="2*"/>
                            <DataGridTextColumn Header="TAMANHO" Binding="{Binding SizeText}" Width="105"/>
                            <DataGridTextColumn Header="MODIFICADO EM" Binding="{Binding LastModifiedText}" Width="150"/>
                            <DataGridTextColumn Header="PASTA DE ORIGEM" Binding="{Binding FolderPath}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="ESTRUTURA DE PASTAS" Style="{StaticResource Label}"/>
                        <TreeView ItemsSource="{Binding FolderRoots}" SelectedItemChanged="FolderTree_SelectedItemChanged"
                                  Background="Transparent" Foreground="{DynamicResource Fg}" BorderThickness="0"
                                  Height="360" VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type app:FolderEntry}" ItemsSource="{Binding Folders}">
                                    <StackPanel Margin="2,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                        <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource Muted}" FontSize="10"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedFolderName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <UniformGrid Columns="3" Margin="0,8,0,10">
                                    <StackPanel><TextBlock Text="ESPAÇO" Style="{StaticResource Label}"/><TextBlock Text="{Binding SelectedFolderSizeText}"/></StackPanel>
                                    <StackPanel><TextBlock Text="ARQUIVOS" Style="{StaticResource Label}"/><TextBlock Text="{Binding SelectedFolderFileCountText}"/></StackPanel>
                                    <StackPanel><TextBlock Text="SUBPASTAS" Style="{StaticResource Label}"/><TextBlock Text="{Binding SelectedFolderSubfolderCountText}"/></StackPanel>
                                </UniformGrid>
                                <Button Content="ABRIR PASTA NO EXPLORADOR" Command="{Binding OpenSelectedFolderCommand}"
                                        Style="{StaticResource OutlineButton}" Padding="14,8" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="INFORMAÇÕES POR EXTENSÃO" Style="{StaticResource Label}"/>
                        <DataGrid ItemsSource="{Binding AnalysisResult.FilesByExtension}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserSortColumns="False" Height="430"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="EXTENSÃO" Binding="{Binding Key}" Width="*"/>
                                <DataGridTextColumn Header="ARQUIVOS" Binding="{Binding Value.FileCountText}" Width="110"/>
                                <DataGridTextColumn Header="ESPAÇO" Binding="{Binding Value.TotalBytesText}" Width="110"/>
                                <DataGridTextColumn Header="DO ANALISADO" Binding="{Binding Value.PercentText}" Width="115"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock Text="MAPA DE ESPAÇO · TREEMAP" Style="{StaticResource Label}" Margin="0"/>
                        <Button Content="VOLTAR À PASTA PAI" Command="{Binding GoUpTreemapCommand}"
                                Style="{StaticResource OutlineButton}" Padding="12,6" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <TextBlock Text="{Binding TreemapFolderPath}" Foreground="{DynamicResource Muted}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TreemapFolderPath}" Margin="0,0,0,9"/>
                    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <disk:TreemapView Tiles="{Binding TreemapTiles}"
                                          SelectedFile="{Binding SelectedFile, Mode=TwoWay}"
                                          SurfaceBrush="{DynamicResource Bg}"
                                          TileBorderBrush="{DynamicResource Line}"
                                          TileTextBrush="{DynamicResource OnAccent}"
                                          LegendTextBrush="{DynamicResource Fg}"
                                          AccentBrush="{DynamicResource Accent}"
                                          MutedBrush="{DynamicResource Muted}"
                                          FolderActivated="TreemapView_FolderActivated"
                                          Height="430" MinHeight="260"/>
                    </Border>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedFile.Name, TargetNullValue='Selecione um arquivo no mapa'}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFile.FullPath}"/>
                                <TextBlock Text="{Binding SelectedFile.FullPath, TargetNullValue=''}" Foreground="{DynamicResource Muted}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFile.FullPath}" Margin="0,3,8,0"/>
                                <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0">
                                    <Run Text="Extensão: "/><Run Text="{Binding SelectedFile.Extension, TargetNullValue='—'}"/>
                                    <Run Text="   Tamanho: "/><Run Text="{Binding SelectedFile.SizeText, TargetNullValue='—'}"/>
                                    <Run Text="   Pasta: "/><Run Text="{Binding SelectedFile.FolderPath, TargetNullValue='—'}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="ABRIR LOCALIZAÇÃO" Command="{Binding OpenFileLocationCommand}"
                                    Style="{StaticResource OutlineButton}" Padding="12,7" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
