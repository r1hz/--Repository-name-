<Project>
  <PropertyGroup>
    <AssemblyName>GeolabTITools</AssemblyName>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>C:\Users\bruno.diniz\Documents\ResetExplode-latest\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>ResetExplode</_TargetAssemblyProjectName>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>GeolabTITools</AssemblyName>
    <AssemblyTitle>GEOLAB TI TOOLS</AssemblyTitle>
    <Product>GEOLAB TI TOOLS</Product>
    <Version>0.17.0</Version>
    <!-- Sempre otimizado: o GEOLAB BENCH e os stress tests precisam do JIT otimizado também em Debug -->
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
  <!-- Drivers seriais oficiais embutidos (GEOLAB MAKER): cada pasta Drivers\<chip> vira recurso e é extraída na hora de instalar.
       Para incluir outro, basta criar a pasta com o .inf/.cat/.sys e ligá-la em MakerDrivers.Chips (Bundle). -->
  <ItemGroup>
    <EmbeddedResource Include="Drivers\**\*" Exclude="Drivers\*.md;Drivers\*.txt" LogicalName="Drivers/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- iCUE SDK da Corsair (GEOLAB INTEGRAÇÃO): se a DLL estiver em Native\, ela vai junto do .exe. Não é versionada no git. -->
  <ItemGroup>
    <None Include="Native\iCUESDK.x64_2019.dll" Condition="Exists('Native\iCUESDK.x64_2019.dll')" Link="iCUESDK.x64_2019.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
